
<div class="@container pb-6 lg:pb-12 space-y-4"
     data-controller="budget-planner"
     data-budget-planner-history-value="<%= @history.as_json.to_json %>"
     data-budget-planner-plan-value="<%= @plan_state.to_json %>"
     data-budget-planner-draft-value="<%= @draft_state.to_json %>"
     data-budget-planner-backup-value="<%= @backup_state.to_json %>"
     data-budget-planner-labels-value="<%= t(".js").to_json %>">
  <div class="flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary">
        <%= t(".subtitle",
              start_date: l(@history.periods.first.first, format: :long),
              end_date: l(@history.periods.last.last, format: :long),
              budget: @budget.name) %>
      </p>
    </div>

    <div class="ml-auto">
      <%= render DS::SegmentedControl.new(aria_label: t(".range_label"), class: "bg-surface-inset") do |control| %>
        <% BudgetPlannersController::MONTH_OPTIONS.each do |months| %>
          <% control.with_segment(t(".months", count: months), active: months == @months,
               href: budget_planner_path(@budget, months: months, **budget_owner_query)) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 @4xl:grid-cols-5 gap-4">
    <div class="@4xl:col-span-3 space-y-4">
      <%= render DS::Card.new do %>
        <h2 class="text-sm font-medium text-secondary mb-2"><%= t(".circles_title") %></h2>
        <div class="w-full aspect-square max-w-xl mx-auto" data-budget-planner-target="circles"></div>
      <% end %>

      <%= render DS::Card.new do %>
        <h2 class="text-sm font-medium text-secondary mb-2">
          <%= t(".history_title") %> ·
          <span class="text-primary" data-budget-planner-target="historyTitle"><%= t(".js.all_categories") %></span>
        </h2>
        <div class="w-full h-56" data-budget-planner-target="history"></div>
      <% end %>
    </div>

    <%= render DS::Card.new(class: "@4xl:col-span-2") do %>
      <%= form_with url: budget_planner_path(@budget, **budget_owner_query), method: :patch, scope: :plan,
            data: { budget_planner_target: "form" } do %>
        <div class="flex items-start justify-between gap-2 mb-3">
          <div>
            <h2 class="text-sm font-medium text-secondary"><%= t(".panel_title") %></h2>
            <p class="text-xs text-subdued"><%= t(".panel_columns") %></p>
          </div>
          <% if @plan_state[:editable] %>
            <%= render DS::SegmentedControl.new(aria_label: t(".fill_label"), class: "bg-surface-inset shrink-0") do |control| %>
              <% %w[average median current].each do |source| %>
                <% control.with_segment(t(".fill.#{source}"), data: { action: "budget-planner#fill", source: source, budget_planner_target: "fillButton" }) %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div data-budget-planner-target="panel" class="text-sm"></div>

        <div class="mt-4 pt-3 border-t border-secondary space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-secondary"><%= t(".budget_total") %></span>
            <span class="font-medium text-primary tabular-nums privacy-sensitive" data-budget-planner-target="budgetTotal"></span>
          </div>
          <div class="flex items-center justify-between gap-2">
            <label for="plan_expected_income" class="text-secondary"><%= t(".expected_income") %></label>
            <div data-budget-planner-target="incomeSlot" class="privacy-sensitive"></div>
          </div>
          <div class="flex items-center justify-between rounded-lg px-2 py-1.5 -mx-2" data-budget-planner-target="remainingRow">
            <span class="font-medium"><%= t(".remaining") %></span>
            <span class="font-medium tabular-nums privacy-sensitive" data-budget-planner-target="remaining"></span>
          </div>
        </div>

        <% if @plan_state[:editable] %>
          <div class="mt-4 flex justify-end">
            <%= render DS::Button.new(
                  text: t(".apply", budget: @budget.name),
                  type: "submit",
                  data: { budget_planner_target: "apply" },
                  confirm: CustomConfirm.new(
                    title: t(".confirm.title", budget: @budget.name),
                    body: t(".confirm.body"),
                    btn_text: t(".confirm.button")
                  )
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
