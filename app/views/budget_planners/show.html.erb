<% plan = @draft_state[:plan] %>
<% can_plan = @draft_state[:can_edit] && @plan_state[:editable] %>

<div class="@container pb-6 lg:pb-12 space-y-4"
     data-controller="budget-planner"
     data-budget-planner-history-value="<%= @history.as_json.to_json %>"
     data-budget-planner-plan-value="<%= @plan_state.to_json %>"
     data-budget-planner-draft-value="<%= @draft_state.to_json %>"
     data-budget-planner-colors-value="<%= Category::COLORS.to_json %>"
     data-budget-planner-labels-value="<%= t(".js").to_json %>">
  <div class="flex flex-wrap items-end gap-3">
    <div>
      <h1 class="text-xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary">
        <%= t(@history.includes_current_period? ? ".subtitle_in_progress" : ".subtitle",
              start_date: l(@history.periods.first.first, format: :long),
              end_date: l(@history.periods.last.last, format: :long),
              count: @history.periods.size,
              budget: @budget.name) %>
      </p>
    </div>

    <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
      <%= render UI::PeriodPicker.new(
            selected: @period,
            url: budget_planner_path(@budget),
            extra_params: budget_owner_query
          ) %>
      <%= render DS::Button.new(text: t(".custom_range"), variant: "outline", icon: "calendar-range", type: "button",
            aria: { expanded: "false" },
            data: { action: "budget-planner#toggleCustomRange", budget_planner_target: "customRangeButton" }) %>
    </div>
    <%= form_with url: budget_planner_path(@budget), method: :get, local: true,
          class: "hidden w-full flex flex-wrap items-end justify-end gap-2",
          data: { budget_planner_target: "customRange" } do %>
      <% budget_owner_query.each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil, autocomplete: "off" %>
      <% end %>
      <div class="form-field w-40">
        <div class="form-field__body">
          <label for="planner_start_date" class="form-field__label"><%= t(".start_date") %></label>
          <%= date_field_tag :start_date, @period.start_date, id: "planner_start_date", class: "form-field__input", autocomplete: "off", required: true %>
        </div>
      </div>
      <div class="form-field w-40">
        <div class="form-field__body">
          <label for="planner_end_date" class="form-field__label"><%= t(".end_date") %></label>
          <%= date_field_tag :end_date, @period.end_date, id: "planner_end_date", class: "form-field__input", autocomplete: "off", required: true %>
        </div>
      </div>
      <%= render DS::Button.new(text: t(".show_range"), variant: "outline", type: "submit") %>
    <% end %>
  </div>

  <% if plan&.dig(:stale) %>
    <%= render DS::Alert.new(variant: :warning, title: t(".stale.title"), message: t(".stale.body")) %>
  <% end %>

  <div class="grid grid-cols-1 @4xl:grid-cols-5 gap-4">
    <div class="@4xl:col-span-3 space-y-4" data-budget-planner-target="chartsColumn">
      <div class="hidden justify-end" data-budget-planner-target="expandPanel">
        <%= render DS::Button.new(text: t(".show_panel"), variant: "outline", icon: "panel-right-open", type: "button",
              data: { action: "budget-planner#showPanel" }) %>
      </div>

      <%= render DS::Card.new do %>
        <h2 class="text-sm font-medium text-secondary mb-2"><%= t(".circles_title") %></h2>
        <div class="w-full aspect-square max-w-xl mx-auto" data-budget-planner-target="circles"></div>
        <p class="hidden mt-2 text-xs text-subdued" data-budget-planner-target="excludedNote"></p>
      <% end %>

      <%= render DS::Card.new do %>
        <h2 class="text-sm font-medium text-secondary mb-2">
          <%= t(".history_title") %> ·
          <span class="text-primary" data-budget-planner-target="historyTitle"><%= t(".js.all_categories") %></span>
        </h2>
        <div class="w-full h-56" data-budget-planner-target="history"></div>
      <% end %>
    </div>

    <%= render DS::Card.new(class: "@4xl:col-span-2", data: { budget_planner_target: "panelCard" }) do %>
      <div class="flex flex-wrap items-end gap-2 mb-2">
        <div class="form-field flex-1 min-w-48">
          <div class="form-field__body">
            <label for="planner_plan" class="form-field__label"><%= t(".plan_label") %></label>
            <select id="planner_plan" class="form-field__input" autocomplete="off"
                    data-budget-planner-target="planSelect" data-action="budget-planner#choosePlan">
              <option value="current" <%= "selected" unless plan %>><%= t(".current_categories") %></option>
              <% @draft_state[:plans].each do |option| %>
                <option value="<%= option[:id] %>" <%= "selected" if plan && option[:id] == plan[:id] %>><%= option[:name] %></option>
              <% end %>
            </select>
          </div>
        </div>
        <% if can_plan %>
          <%= render DS::Button.new(variant: "icon", icon: "plus", type: "button", title: t(".new_plan"),
                aria: { label: t(".new_plan"), expanded: "false" },
                data: { action: "budget-planner#toggleNewPlan", budget_planner_target: "newPlanButton" }) %>
          <% if plan %>
            <%= render DS::Button.new(variant: "icon", icon: "pencil", type: "button", title: t(".rename_plan"),
                  aria: { label: t(".rename_plan") }, data: { action: "budget-planner#renamePlan" }) %>
            <%= render DS::Button.new(variant: "icon", icon: "trash-2", title: t(".delete_plan"),
                  aria: { label: t(".delete_plan") },
                  href: budget_planner_plan_path(@budget, plan[:id], **budget_owner_query), method: :delete,
                  confirm: CustomConfirm.new(title: t(".delete_plan_confirm.title", name: plan[:name]), body: t(".delete_plan_confirm.body"), btn_text: t(".delete_plan"), destructive: true)) %>
          <% end %>
        <% end %>
        <div class="ml-auto hidden @4xl:flex items-center gap-1">
          <%= render DS::Button.new(variant: "icon", icon: "panel-right-close", type: "button",
                aria: { label: t(".hide_panel") }, title: t(".hide_panel"),
                data: { action: "budget-planner#hidePanel" }) %>
        </div>
      </div>
      <p class="text-xs text-subdued min-h-4 mb-2" data-budget-planner-target="draftStatus" role="status"></p>

      <% if can_plan %>
        <div class="hidden mb-3 p-3 rounded-lg bg-surface-inset space-y-2" data-budget-planner-target="newPlanForm">
          <div class="form-field">
            <input type="text" class="form-field__input" maxlength="60" autocomplete="off"
                   placeholder="<%= t(".new_plan_name") %>" aria-label="<%= t(".new_plan_name") %>"
                   data-budget-planner-target="newPlanName"
                   data-action="keydown.enter->budget-planner#createPlan:prevent">
          </div>
          <fieldset class="flex flex-wrap gap-3 text-sm text-secondary">
            <legend class="sr-only"><%= t(".new_plan_from") %></legend>
            <label class="flex items-center gap-1">
              <input type="radio" name="planner_new_plan_from" value="current" checked data-budget-planner-target="newPlanFrom">
              <%= t(".new_plan_from_current") %>
            </label>
            <% if plan %>
              <label class="flex items-center gap-1">
                <input type="radio" name="planner_new_plan_from" value="<%= plan[:id] %>" data-budget-planner-target="newPlanFrom">
                <%= t(".new_plan_copy", name: plan[:name]) %>
              </label>
            <% end %>
          </fieldset>
          <div class="flex justify-end gap-2">
            <%= render DS::Button.new(text: t(".cancel"), variant: "ghost", type: "button", data: { action: "budget-planner#toggleNewPlan" }) %>
            <%= render DS::Button.new(text: t(".create_plan"), type: "button", data: { action: "budget-planner#createPlan" }) %>
          </div>
        </div>

        <div class="flex items-center gap-2 mb-3">
          <div class="form-field flex-1">
            <input type="text" class="form-field__input" maxlength="60" autocomplete="off"
                   placeholder="<%= t(".new_group_placeholder") %>"
                   aria-label="<%= t(".new_group_placeholder") %>"
                   data-budget-planner-target="newGroupName"
                   data-action="keydown.enter->budget-planner#addGroup:prevent">
          </div>
          <%= render DS::Button.new(text: t(".new_group"), variant: "outline", icon: "plus", type: "button",
                data: { action: "budget-planner#addGroup" }) %>
        </div>
      <% end %>

      <%= form_with url: budget_planner_path(@budget, **budget_owner_query), method: :patch, scope: :plan,
            data: { budget_planner_target: "form" } do %>
        <input type="hidden" name="plan[plan_id]" value="<%= plan&.dig(:id) %>" autocomplete="off" data-budget-planner-target="planId">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-3">
          <div class="form-field w-40">
            <div class="form-field__body">
              <label for="planner_sort" class="form-field__label"><%= t(".sort_label") %></label>
              <select id="planner_sort" class="form-field__input" autocomplete="off"
                      data-budget-planner-target="sortSelect" data-action="budget-planner#changeSort">
                <% %w[spending budget name].each do |sort| %>
                  <option value="<%= sort %>"><%= t(".sort.#{sort}") %></option>
                <% end %>
              </select>
            </div>
          </div>
          <% if @plan_state[:editable] %>
            <div class="text-right">
              <p class="text-xs text-subdued mb-1"><%= t(".fill_label") %></p>
              <%= render DS::SegmentedControl.new(aria_label: t(".fill_label"), class: "bg-surface-inset") do |control| %>
                <% %w[average median current].each do |source| %>
                  <% control.with_segment(t(".fill.#{source}"), data: { action: "budget-planner#fill", source: source }) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-subdued mb-2"><%= t(".panel_columns") %></p>

        <div data-budget-planner-target="panel" class="text-sm"></div>

        <div class="mt-4 pt-3 border-t border-secondary space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-secondary"><%= t(".budget_total") %></span>
            <span class="font-medium text-primary tabular-nums privacy-sensitive" data-budget-planner-target="budgetTotal"></span>
          </div>
          <div class="flex items-center justify-between gap-2">
            <label for="plan_expected_income" class="text-secondary"><%= t(".expected_income") %></label>
            <div data-budget-planner-target="incomeSlot" class="privacy-sensitive"></div>
          </div>
          <div class="flex items-center justify-between rounded-lg px-2 py-1.5 -mx-2" data-budget-planner-target="remainingRow">
            <span class="font-medium"><%= t(".remaining") %></span>
            <span class="font-medium tabular-nums privacy-sensitive" data-budget-planner-target="remaining"></span>
          </div>
        </div>

        <% if @plan_state[:editable] %>
          <p class="mt-3 text-xs text-secondary hidden" data-budget-planner-target="draftSummary"></p>
          <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
            <%= render DS::Button.new(
                  text: t(".apply", budget: @budget.name),
                  type: "submit",
                  data: { budget_planner_target: "apply" },
                  confirm: CustomConfirm.new(
                    title: t(".confirm.title", budget: @budget.name),
                    body: t(".confirm.body"),
                    btn_text: t(".confirm.button")
                  )
                ) %>
          </div>
        <% end %>
      <% end %>

      <% if @backup_state && can_plan %>
        <% restore_text = t(".restore", date: l(Time.zone.parse(@backup_state[:created_at]), format: :short)) %>
        <div class="mt-2 flex justify-end">
          <%= render DS::Button.new(
                text: restore_text,
                variant: "ghost",
                href: budget_planner_restore_path(@budget, **budget_owner_query),
                method: :post,
                confirm: CustomConfirm.new(
                  title: t(".restore_confirm.title"),
                  body: t(".restore_confirm.body", budget: @backup_state[:budget_name] || @budget.name),
                  btn_text: restore_text
                )
              ) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Colour and icon picker, shown by the row menu's "Colour & icon". %>
  <div class="hidden fixed z-50 w-80 max-w-[calc(100vw-2rem)] p-4 bg-container rounded-2xl shadow-border-xs space-y-3"
       role="dialog" aria-label="<%= t(".appearance_title") %>"
       data-budget-planner-target="appearance">
    <p class="text-sm font-medium text-primary" data-budget-planner-target="appearanceTitle"></p>
    <div data-budget-planner-target="appearanceColors">
      <p class="text-xs text-secondary mb-1"><%= t(".colour") %></p>
      <div class="flex flex-wrap gap-1.5">
        <% Category::COLORS.each do |color| %>
          <button type="button" class="w-6 h-6 rounded-full border border-secondary focus-ring" style="background-color: <%= color %>"
                  aria-label="<%= color %>" data-color="<%= color %>" data-action="budget-planner#pickColor"></button>
        <% end %>
      </div>
    </div>
    <p class="hidden text-xs text-subdued" data-budget-planner-target="appearanceColorNote"><%= t(".colour_follows_parent") %></p>
    <%= form_with url: "#", scope: :appearance, data: { action: "change->budget-planner#pickIcon submit->budget-planner#closeAppearance:prevent" } do |f| %>
      <p class="text-xs text-secondary mb-1"><%= t(".icon") %></p>
      <%= render DS::IconPicker.new(form: f, method: :icon, icons: Category.icon_codes) %>
    <% end %>
    <div class="flex justify-end">
      <%= render DS::Button.new(text: t(".done"), variant: "outline", type: "button", data: { action: "budget-planner#closeAppearance" }) %>
    </div>
  </div>

  <%# Remove a category: where its transactions go. Filled by the controller. %>
  <div class="hidden fixed z-50 w-96 max-w-[calc(100vw-2rem)] p-4 bg-container rounded-2xl shadow-border-xs space-y-3"
       role="dialog" aria-modal="true" aria-labelledby="planner_remove_title"
       data-budget-planner-target="removeDialog">
    <p id="planner_remove_title" class="text-sm font-medium text-primary" data-budget-planner-target="removeTitle"></p>
    <p class="text-sm text-secondary" data-budget-planner-target="removeChildrenNote"></p>
    <div class="space-y-2" data-budget-planner-target="removeTargetFields">
      <div class="form-field">
        <div class="form-field__body">
          <label for="planner_remove_target" class="form-field__label" data-budget-planner-target="removeTargetLabel"></label>
          <select id="planner_remove_target" class="form-field__input" autocomplete="off"
                  data-budget-planner-target="removeTarget" data-action="budget-planner#removeTargetChanged"></select>
        </div>
      </div>
      <div class="hidden form-field" data-budget-planner-target="removeNewNameField">
        <div class="form-field__body">
          <label for="planner_remove_new_name" class="form-field__label"><%= t(".remove_new_name") %></label>
          <input type="text" id="planner_remove_new_name" class="form-field__input" maxlength="60" autocomplete="off"
                 data-budget-planner-target="removeNewName">
        </div>
      </div>
    </div>
    <p class="text-xs text-destructive" data-budget-planner-target="removeError" role="alert"></p>
    <div class="flex justify-end gap-2">
      <%= render DS::Button.new(text: t(".cancel"), variant: "ghost", type: "button", data: { action: "budget-planner#closeRemove" }) %>
      <%= render DS::Button.new(text: t(".remove"), variant: "destructive", type: "button", data: { action: "budget-planner#confirmRemove" }) %>
    </div>
  </div>

  <%# Icons the panel rows draw, cloned by the controller. %>
  <div class="hidden" data-budget-planner-target="iconSprites">
    <% (Category.icon_codes | Current.family.categories.pluck(:lucide_icon) | %w[circle-dashed folder]).each do |name| %>
      <span data-icon="<%= name %>"><%= icon(name, size: "sm", color: "current") %></span>
    <% end %>
  </div>
</div>
